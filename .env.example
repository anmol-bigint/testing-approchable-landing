# Vercel Blob (from Vercel project → Storage → Blob → Connect)
# Local dev: copy BLOB_READ_WRITE_TOKEN from the Vercel Blob store settings.
# On Vercel: connecting Blob to the project auto-injects BLOB_READ_WRITE_TOKEN and BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
# Set automatically when Blob is connected on Vercel; required for OIDC auth if token is absent.
BLOB_STORE_ID=
# Admin gate — set to protect /admin/submissions (leave unset to allow open access in dev)
ADMIN_SECRET=secret
# Resend — admin notification emails for forms and new subscribers (failures never block the request)
RESEND_API_KEY=
# Inbox that receives contact, corporate, and new-subscriber alerts
RESEND_TO=ranbeer@bigintsolutions.com
